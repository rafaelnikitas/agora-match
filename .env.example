# Local demo needs no Azure settings. Export values before starting the Python server.
# Example endpoint: https://YOUR-RESOURCE.openai.azure.com/openai/v1
# Foundry project: https://YOUR-RESOURCE.services.ai.azure.com/api/projects/agora-match/openai/v1
AZURE_FOUNDRY_BASE_URL=
# Foundry project endpoints use https://ai.azure.com/.default instead.
AZURE_FOUNDRY_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
# auto selects an API key when supplied; otherwise an explicitly configured identity.
# Azure infrastructure uses managed_identity. For local az login use default_credential.
AZURE_FOUNDRY_AUTH_MODE=auto
AZURE_CLIENT_ID=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=
# Set all three to use the checked pipeline. They may share a deployment or use different ones.
AZURE_FOUNDRY_READER_DEPLOYMENT=
AZURE_FOUNDRY_WRITER_DEPLOYMENT=
AZURE_FOUNDRY_REVIEWER_DEPLOYMENT=
# Comma-separated deployment names using reasoning models; omits temperature and uses max_completion_tokens.
AZURE_FOUNDRY_REASONING_DEPLOYMENTS=
# Use low for the example gpt-5.4-mini deployment; leave blank for models without this parameter.
AZURE_FOUNDRY_REASONING_EFFORT=
AGORA_MODEL_TIMEOUT_SECONDS=8
AGORA_ANSWER_BUDGET_SECONDS=24
AGORA_MODEL_CALLS_PER_MINUTE=24
AGORA_MODEL_CONCURRENCY=2
AGORA_API_REQUESTS_PER_MINUTE=60
AGORA_CACHE_SECONDS=60
AGORA_REQUIRE_AI=false
# Azure Monitor is optional locally. Do not expose this value in frontend code.
APPLICATIONINSIGHTS_CONNECTION_STRING=
PORT=8080
